# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=dev-secret-change-me-in-production-32chars
# Optional for signed preview links; logged-in Payload users do not need it.
# PREVIEW_SECRET=
# Optional future error reporting provider (the current monitoring adapter logs locally).
# SENTRY_DSN=

# Visible operating mode in /admin-v2. Full automation is accepted only after
# LEAD_INBOX_PILOT_REFERENCE contains the completed real-pilot report ID.
PLATFORM_OPERATING_MODE=controlled_pilot
PLATFORM_ACTIVE_WAVE=PROD-8.0
# Fail-closed in Production when omitted. Set to false only for an approved
# wave that may send automatic commercial or operational communications.
AUTOMATION_EMERGENCY_PAUSE=true
# Controlled-pilot automatic email sends fail closed unless the normalized
# recipient is listed here. Comma-separated email addresses.
AUTOMATION_RECIPIENT_ALLOWLIST=
# Every real Preview email transport (manual, automatic and intake notice)
# fails closed unless every to/cc/bcc address is listed here. Keep this scoped
# to the dedicated Preview deployment; Production behavior is unchanged.
PREVIEW_EMAIL_RECIPIENT_ALLOWLIST=
# Minimum interval between payment-reminder drafts/sends. Defaults to 7.
PAYMENT_REMINDER_COOLDOWN_DAYS=7

# Risky platform capabilities are disabled unless explicitly set to true/1.
FEATURE_AI_DRAFTS=false
FEATURE_ROOF_MEASUREMENT=false
FEATURE_CUSTOMER_QUOTES=false
FEATURE_CONTRACT_SIGNING=false
FEATURE_WORKER_PORTAL=false
FEATURE_AUTOMATED_REMINDERS=false
WORK_ORDER_SAME_DAY_MESSAGE=true
LEGACY_LEAD_PHOTO_TOKEN_CUTOFF=
FEATURE_SEO_SCHEDULER=false
# Scheduled SEO publishing is a separate, stricter gate. Keep false while SEO
# draft generation is piloted and publish only through explicit admin review.
FEATURE_SEO_AUTO_PUBLISH=false

# FULL audit remediation capabilities. Keep disabled until the matching F-phase
# report has all five PASS/YES gates recorded.
FEATURE_CASE_STATE_ENGINE_V2=false
FEATURE_MEASUREMENT_EVIDENCE_V2=false
FEATURE_ADMIN_EXCEPTION_FLOWS_V2=false
FEATURE_COMMUNICATION_ROUTING_V2=false
FEATURE_CUSTOMER_LIFECYCLE_V2=false
FEATURE_SECURITY_HARDENING_V2=false

# Admin Next remains opt-in. The two mutation flags are Preview-only and are
# rejected before authentication/database access in every other environment.
ADMIN_NEXT_MODE=off
# UI capability projection for an authenticated admin in dedicated Preview E2E.
# Server mutation routes remain authoritative and keep their own guards.
PREVIEW_E2E_OPERATOR_ACCESS=false
FEATURE_ROOF_FUSION_V1=false
FEATURE_ADMIN_NEXT_CASE_ADDRESS_COMMAND=false
FEATURE_ADMIN_NEXT_RF_OFFER_BRIDGE=false
# Preview-only safety mode for synthetic commercial UAT. It permits only the
# fixed nonbinding test-terms reference; price rules and terms must still be
# explicitly created/approved. Production ignores it even if accidentally set.
PREVIEW_E2E_NONBINDING_DOCUMENTS=false
# One-shot bootstrap requires all three values plus the exact approved isolated
# database host. Never store the real DATABASE_URL or credentials in this file.
PREVIEW_E2E_BOOTSTRAP=off
# PREVIEW_E2E_EXPECTED_DB_HOST=
# PREVIEW_E2E_BOOTSTRAP_ACTION=status

# Optional OpenStreetMap Overpass endpoint for low-volume building-footprint
# lookup. The public default is used when unset; keep administrator review on.
# OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# OSM_OVERPASS_FALLBACK_ENDPOINT=
# OSM_MAP_ENDPOINT=https://api.openstreetmap.org/api/0.6/map

# Local default: SQLite (no Docker needed).
# Production / Docker: postgres://payload:payload@db:5432/takfornying
# Staging: use a Neon branch connection string (see README → Database migrations)
DATABASE_URL=file:./takfornying.db

# Optional: point build:migrate / scripts at a different DB without changing DATABASE_URL
# DATABASE_URL_MIGRATE=
# Vercel Preview per-deployment Neon branch safety (build-only; do not store
# credentials or connection strings here). The release command must temporarily
# override DATABASE_URL_MIGRATE to an empty value so migrations use the branch
# supplied to that deployment. These two controls fail closed when omitted.
# PREVIEW_BASE_DATABASE_ENDPOINT_SHA256=
# PREVIEW_EXPECTED_NEON_PROJECT_ID=

# Vercel Blob (Media uploads). Create in Vercel → Storage → Blob,
# then copy BLOB_READ_WRITE_TOKEN into Vercel env + local .env
BLOB_READ_WRITE_TOKEN=

# Lead notifications (optional – logs to console if unset)
RESEND_API_KEY=
# Preview only: permits end-to-end QA while keeping customer email in logs.
# Production always requires RESEND_API_KEY.
ALLOW_PREVIEW_EMAIL_LOG=false
LEAD_FROM_EMAIL=Takfornyelse <post@takfornyelse.as>
LEAD_TO_EMAIL=post@takfornyelse.as
# Used only when LEAD_TO_EMAIL does not match an active administrator profile.
# Valid values: nb, lt, en. Customer-facing language is not affected.
LEAD_ADMIN_NOTIFICATION_FALLBACK_LOCALE=nb
# Public origin for images embedded in email. Do not point this at a protected
# Preview deployment because mail clients cannot use a Vercel login session.
# EMAIL_ASSET_BASE_URL=https://www.takfornyelse.as
# Resend webhook signing secret for delivery/bounce status updates.
# RESEND_WEBHOOK_SECRET=
# Optional inbound reply domain configured in Resend, preferably an isolated
# subdomain such as replies.takfornyelse.as. Each case gets a signed Reply-To.
# RESEND_INBOUND_DOMAIN=

# AI provider (disabled/fake when unset)
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_DAILY_REQUEST_LIMIT=20
# GEMINI_MONTHLY_REQUEST_LIMIT=400

# Optional free-license stock imagery for AI blog drafts. Create a Pexels API
# key and store it only in the hosting secret store (Preview first).
# PEXELS_API_KEY=

# Norge i bilder: user-triggered, single-case interactive-page screenshot.
# This is not WMS/WMTS. The Chromium-min pack must be hosted over HTTPS at a
# trusted location directly readable by the Vercel function, never committed.
# A durable Upstash/KV store is also required to enforce click/day/month caps.
# Record the Kartverket email/ticket reference, not personal contact details.
# NORGE_I_BILDER_CAPTURE_APPROVAL_REFERENCE=
# NORGE_I_BILDER_CHROMIUM_PACK_URL=

# Customer links and signing. Falls back to PAYLOAD_SECRET for local/test only.
# CUSTOMER_TOKEN_SECRET=
# SIGNATURE_PROVIDER=internal
# Reference to the completed Norwegian legal review (ticket/document ID only).
# LEGAL_REVIEW_REFERENCE=

# Production release evidence. Values are ticket/document IDs only, never
# customer data or secrets. A risky feature remains no-go until its required
# references and integrations are present.
# STAGING_QA_REFERENCE=
# RESTORE_TEST_REFERENCE=
# Required only to leave controlled-pilot mode after 20–30 real cases.
# LEAD_INBOX_PILOT_REFERENCE=
# PRODUCTION_OWNER_APPROVAL_REFERENCE=
# AI_CONTENT_PILOT_REFERENCE=
# ROOF_VALIDATION_REFERENCE=
# ROOF_TECHNICAL_QA_REFERENCE=
# PRICING_APPROVAL_REFERENCE=
# QUOTE_JOURNEY_QA_REFERENCE=
# SIGNATURE_APPROVAL_REFERENCE=
# CONTRACT_JOURNEY_QA_REFERENCE=
# WORKER_MOBILE_QA_REFERENCE=
# COMMUNICATION_APPROVAL_REFERENCE=
# SEO_PILOT_REFERENCE=
# STATE_INVARIANT_QA_REFERENCE=
# ROOF_EVIDENCE_QA_REFERENCE=
# ADMIN_OPERATIONS_QA_REFERENCE=
# COMMUNICATION_V2_QA_REFERENCE=
# CUSTOMER_LIFECYCLE_QA_REFERENCE=
# SECURITY_HARDENING_QA_REFERENCE=

# Authenticated Preview E2E. Use the Preview-only Vercel automation bypass
# secret; never commit its value and never expose it through NEXT_PUBLIC_*.
# PLAYWRIGHT_BASE_URL=https://takfornyelse-staging.vercel.app
# VERCEL_AUTOMATION_BYPASS_SECRET=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_WORKER_EMAIL=
# E2E_WORKER_PASSWORD=
# CI-only safety switch for scripts/seed-e2e-accounts.mjs. Never enable this
# against staging or production data.
# E2E_SEED_ALLOWED=false

# SMS is intentionally disabled until provider, consent and templates are approved.
SMS_PROVIDER=disabled
# SMS_API_KEY=

# Optional SEO data sources. Credentials belong in the hosting secret store.
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS=
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:takfornyelse.as
# SEO_IMPORT_BUCKET=

# Cloudflare Turnstile (spam protection for contact form) — Phase 1
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Google Search Console URL-prefix verification (optional; DNS Domain property is preferred)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Upstash Redis (persistent rate limiting) — Phase 1
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace may expose the equivalent aliases instead:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Cron auth for all /api/cron routes. GitHub Actions uses the same value in the
# TAKFORNYELSE_CRON_SECRET repository secret and TAKFORNYELSE_CRON_URL variable.
# CRON_SECRET=

# Advertising measurement (loaded only after visitor consent)
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-ENMB8696J8
# Example Google Ads ID: AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18395015353
# Conversion label from Google Ads -> Goals -> Conversions -> Tag setup
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=MEIiCKPAk-UcELnRtsNE
# Numeric Meta Pixel / Dataset ID
NEXT_PUBLIC_META_PIXEL_ID=1015457044803165
