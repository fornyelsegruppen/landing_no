{
  "name": "takfornying",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:migrate && next build",
    "build:migrate": "node scripts/run-migrate.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci:unit": "vitest run --exclude \"**/payload/migration-tests/**\" --maxWorkers=2",
    "test:ci:migrations": "vitest run src/payload/migration-tests --maxWorkers=1 --fileParallelism=false",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:push": "node --env-file=.env scripts/push-schema-jiti.mjs",
    "db:bootstrap": "node --env-file=.env scripts/push-schema-jiti.mjs --baseline-current-migrations",
    "db:seed": "node --env-file=.env scripts/seed-cms-sql.mjs",
    "db:seed-copy": "node --env-file=.env scripts/seed-page-copy.mjs",
    "db:ensure": "node --env-file=.env scripts/ensure-cms-schema.mjs",
    "db:ensure-copy": "node --env-file=.env scripts/ensure-page-copy-schema.mjs",
    "db:migrate": "node --env-file=.env scripts/run-migrate.mjs",
    "db:migrate:status": "node --env-file=.env scripts/run-migrate-status.mjs",
    "db:migrate:baseline": "node --env-file=.env scripts/create-baseline-migration.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "graphql": "^16.14.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.2",
    "next-intl": "^4.13.2",
    "payload": "3.88.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
